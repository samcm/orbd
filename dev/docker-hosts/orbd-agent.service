[Unit]
Description=orbd agent (dev docker host)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
ExecStart=/usr/local/bin/orbd agent
Environment=RUST_LOG=info
# ORBD_JOIN=<token>; only read until the agent has enrolled.
EnvironmentFile=/etc/orbd/agent.env
# /var/lib/orbd, the agent's default state directory.
StateDirectory=orbd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
