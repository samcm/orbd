#!/bin/sh
# A tailscaled killed without restoring resolv.conf (e.g. by `amp orb restart-processes`):
# once orbd-guest has written resolv.conf, replace it with Tailscale's, whose resolver
# died with it. orbd-guest must put its own back by itself, without a wake.
ours='Written by orbd-guest'
n=0
until grep -q "$ours" /etc/resolv.conf 2>/dev/null; do
    n=$((n + 1))
    [ "$n" -gt 120 ] && { echo "stale-dns: orbd-guest never wrote /etc/resolv.conf"; exit 0; }
    sleep 1
done
printf '# resolv.conf(5) file generated by tailscale\nnameserver 100.100.100.100\n' >/etc/resolv.conf
echo "stale-dns: planted"
n=0
until grep -q "$ours" /etc/resolv.conf; do
    n=$((n + 1))
    [ "$n" -gt 60 ] && { echo "stale-dns: still stale after 60 s"; exit 0; }
    sleep 1
done
echo "stale-dns: restored after $n s"
